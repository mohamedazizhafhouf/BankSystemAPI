### Variables Setup (Optional: You can use http-client.env.json)
### 1. Provision a New Bank Workspace
# This simulates the Super-Admin creating a new tenant (e.g., Zitouna Bank)
POST http://{{host}}:{{port}}/api/v1/system/provision
Content-Type: application/json
X-Mely-System-Key: {{systemKey}}

{
  "firstName": "Mohamed",
  "lastName": "Hafhouf",
  "bankName": "Zitouna Bank",
  "adminEmail": "admin@zitouna.tn",
  "tempPassword": "Password123!"
}

> {%
    client.test("Request executed successfully", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 2. Login as the New Bank Admin
# After provisioning, test if the new admin can actually get a JWT
POST http://{{host}}:{{port}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "admin@zitouna.tn",
  "password": "Password123!"
}

### 3. Create a new employee as bank admin
@authToken = YOUR_JWT_HERE

POST http://{{host}}:{{port}}/api/v1/bank/employees
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "firstName": "Loan",
  "lastName": "Officer",
  "email": "loan.officer@zitouna.tn",
  "password": "Password123!",
  "role": "LOAN_OFFICER"
}

### 4. List organization employees
GET http://{{host}}:{{port}}/api/v1/bank/employees
Authorization: Bearer {{authToken}}

### 5. Login as the created employee
POST http://{{host}}:{{port}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "loan.officer@zitouna.tn",
  "password": "Password123!"
}
